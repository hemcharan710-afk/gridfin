# Copy to .env and fill in to enable live model calls.
# When no key is set (or GRIDFIN_MOCK_LLM=true), GridFin runs in mock mode: the
# pipeline still runs end to end on the bundled demo dataset with no network calls.

# Which provider to use for the language steps: "anthropic" or "openai".
GRIDFIN_LLM_PROVIDER=anthropic

# --- Anthropic (used when provider = anthropic) ---
ANTHROPIC_API_KEY=
GRIDFIN_MODEL_SMALL=claude-haiku-4-5-20251001
GRIDFIN_MODEL_LARGE=claude-opus-4-8

# --- OpenAI (used when provider = openai) ---
GRIDFIN_OPENAI_API_KEY=
GRIDFIN_OPENAI_MODEL_SMALL=gpt-4o-mini
GRIDFIN_OPENAI_MODEL_LARGE=gpt-4o

# Per-cell fan-out concurrency cap (semaphore).
GRIDFIN_MAX_CONCURRENCY=8

# Force mock mode even if a key is present (useful for tests / offline demos).
GRIDFIN_MOCK_LLM=false
